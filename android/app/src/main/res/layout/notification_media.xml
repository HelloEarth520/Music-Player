<?xml version="1.0" encoding="utf-8"?>
<!-- 通知栏媒体控制（v2.22.8 视觉打磨）：浅色版（白底深字，贴近系统浅色主题）。
     打磨点：封面 48→56dp 更突出、标题 15→16sp、歌词行 12/11→13/12sp 层级更清晰、
     行距留白收紧、进度条 6→5dp 更细、按钮行高度 50→46dp 图标加大（play 加更明显）、
     整体向网易云/AeScReam 媒体卡质感靠拢。纯视觉，控件 id 与 Java/JS 契约零改动。
     结构：封面 + 标题 + 两行歌词；时间 + 渐变进度条（上层 10 段等宽透明点击区，点哪跳哪）；
     底行 上一首/播放暂停/下一首 三等宽大按钮撑满整行。
     歌词可见性逻辑不变：line1 无词时显示歌手、line2 无下一句时 GONE → 无歌词排版自动收紧。
     锁屏由系统媒体卡接管（MediaStyle token），此自定义视图只影响通知栏/锁屏内容区。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#F7FFFFFF"
    android:padding="0dp">

    <!-- Row 1: 封面 + 标题/歌词 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/notif_cover"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:scaleType="centerCrop"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_stat_music"
            android:background="@drawable/notif_cover_bg" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="14dp"
            android:layout_marginLeft="14dp">

            <TextView
                android:id="@+id/notif_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FF111827"
                android:textSize="16sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/notif_line1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="#FF1F2937"
                android:textSize="13sp"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/notif_line2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:textColor="#FF6B7280"
                android:textSize="12sp"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <!-- Row 2: 当前时间 + 进度条 + 总时长；上层叠 10 个等宽透明点击区（点哪跳哪） -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="2dp"
            android:paddingBottom="6dp"
            android:paddingLeft="18dp"
            android:paddingRight="18dp">

            <TextView
                android:id="@+id/notif_cur"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="34dp"
                android:textColor="#FF6B7280"
                android:textSize="11sp"
                android:text="0:00" />

            <ProgressBar
                android:id="@+id/notif_seek"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="5dp"
                android:minHeight="5dp"
                android:maxHeight="5dp"
                android:layout_weight="1"
                android:max="1000"
                android:progressDrawable="@drawable/notif_progress"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingLeft="10dp"
                android:paddingRight="10dp" />

            <TextView
                android:id="@+id/notif_dur"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="34dp"
                android:gravity="end"
                android:textColor="#FF6B7280"
                android:textSize="11sp"
                android:text="0:00" />
        </LinearLayout>

        <!-- 10 段等宽透明点击区：整体铺满进度行；原生把点到的比例换算成秒广播 seek。
             用 ImageButton（系统通知标准可点控件）而非 View，确保 vivo SystemUI 可渲染 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <ImageButton android:id="@+id/notif_zone0"  android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent" android:src="@null" android:scaleType="fitXY" android:padding="0dp" />
            <ImageButton android:id="@+id/notif_zone1"  android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent" android:src="@null" android:scaleType="fitXY" android:padding="0dp" />
            <ImageButton android:id="@+id/notif_zone2"  android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent" android:src="@null" android:scaleType="fitXY" android:padding="0dp" />
            <ImageButton android:id="@+id/notif_zone3"  android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent" android:src="@null" android:scaleType="fitXY" android:padding="0dp" />
            <ImageButton android:id="@+id/notif_zone4"  android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent" android:src="@null" android:scaleType="fitXY" android:padding="0dp" />
            <ImageButton android:id="@+id/notif_zone5"  android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent" android:src="@null" android:scaleType="fitXY" android:padding="0dp" />
            <ImageButton android:id="@+id/notif_zone6"  android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent" android:src="@null" android:scaleType="fitXY" android:padding="0dp" />
            <ImageButton android:id="@+id/notif_zone7"  android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent" android:src="@null" android:scaleType="fitXY" android:padding="0dp" />
            <ImageButton android:id="@+id/notif_zone8"  android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent" android:src="@null" android:scaleType="fitXY" android:padding="0dp" />
            <ImageButton android:id="@+id/notif_zone9"  android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent" android:src="@null" android:scaleType="fitXY" android:padding="0dp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Row 3: 上一首 / 播放暂停 / 下一首：三等宽撑满；高度收窄、图标加大更精致 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="0dp"
        android:paddingBottom="6dp">

        <ImageButton
            android:id="@+id/notif_prev"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_media_prev"
            android:scaleType="centerInside"
            android:padding="10dp" />

        <ImageButton
            android:id="@+id/notif_playpause"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_media_pause"
            android:scaleType="centerInside"
            android:padding="4dp" />

        <ImageButton
            android:id="@+id/notif_next"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_media_next"
            android:scaleType="centerInside"
            android:padding="10dp" />
    </LinearLayout>
</LinearLayout>
